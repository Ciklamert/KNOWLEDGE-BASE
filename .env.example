# ==========================================================================================
#  AI-BRAIN configuration. Copy to .env (setup does this) and fill in the REQUIRED values.
#  Every value can also be changed later in the web UI (Settings), which edits this same file.
#  Generated from brain/settings.py by tools/gen_config.py - all settings are listed here.
#  Raw engine variables: LIGHTRAG__<NAME>=value -> LightRAG, CBM__<NAME>=value -> code engine.
# ==========================================================================================

# ---- Server --------------------------------------------------------------------------------
# Bind address. 0.0.0.0 = reachable from any IP (login required).
BRAIN_HOST=0.0.0.0
# Port for UI, REST API, MCP and webhooks.
BRAIN_PORT=8765
# Address users and agents use, e.g. http://10.0.0.5:8765 (shown in the UI).
BRAIN_PUBLIC_URL=
# Login user name for the web UI and API (Basic auth).
BRAIN_UI_USER=admin
# REQUIRED. Login password (UI + API). The server refuses to listen on a network address without it.
BRAIN_UI_PASSWORD=
# Bearer token for AI agents (REST + MCP). Empty = only user/password.
BRAIN_API_TOKEN=
# Signs login cookies. Empty = generated once and stored in the data folder.
BRAIN_SECRET_KEY=
# How long a UI login stays valid.
BRAIN_SESSION_HOURS=12
# PEM certificate file to serve HTTPS (optional).
BRAIN_TLS_CERT=
# PEM private key file for HTTPS (optional).
BRAIN_TLS_KEY=
# Where all state lives (graphs, documents, clones). Relative = inside the install.
BRAIN_DATA_DIR=data
# Largest accepted document upload.
BRAIN_MAX_UPLOAD_MB=200

# ---- Corporate API -------------------------------------------------------------------------
# REQUIRED. OpenAI-compatible base URL, ending in /v1. Example: https://llm-gateway.corp.local/v1
BRAIN_LLM_BASE_URL=
# REQUIRED. API key for the base URL.
BRAIN_LLM_API_KEY=
# REQUIRED. Default chat model (used by every role that has no own model). Example: corporate-chat-model
BRAIN_LLM_MODEL=
# REQUIRED. Embedding model (multilingual, e.g. bge-m3): documents, the multilingual code vectors and re-ranking. Example: bge-m3
BRAIN_EMBEDDING_MODEL=
# REQUIRED. Embedding vector size. Changing it (or the model) requires re-ingesting documents; code vectors rebuild by themselves.
BRAIN_EMBEDDING_DIM=1024
# Only if embeddings live on a different URL.
BRAIN_EMBEDDING_BASE_URL=
# Only if embeddings need a different key.
BRAIN_EMBEDDING_API_KEY=
# Vision model for images and scanned pages in documents (optional).
BRAIN_VLM_MODEL=
# Corporate CA certificate (PEM) for TLS interception.
BRAIN_CA_BUNDLE=
# Verify TLS certificates of the corporate API.
BRAIN_VERIFY_TLS=true
# Default seconds for one chat/embedding HTTP call.
BRAIN_LLM_TIMEOUT=120
# auto = use native tool calling, fall back if the gateway rejects it; native; off = one-shot with context. One of: auto, native, off.
BRAIN_AGENT_TOOL_CALLING=auto

# ---- Relevance -----------------------------------------------------------------------------
# How many key terms are extracted from a prompt (most important first).
BRAIN_QUERY_MAX_TERMS=12
# Extra stop-words to ignore, comma separated (company jargon, e.g. proje, ekip, ticket). Built-in: English + Turkish.
BRAIN_STOPWORDS_EXTRA=
# Re-rank code and document results by meaning with the corporate embedding model (multilingual).
BRAIN_RERANK=true
# How many code candidates are re-ranked (more = better recall, slower).
BRAIN_RERANK_CANDIDATES=30
# Share of meaning vs. lexical rank in the final order (0-1).
BRAIN_RERANK_WEIGHT=0.6
# Use the domain entities found in documents as extra code-search terms (business words -> code).
BRAIN_DOC_BRIDGE=true
# Add callers, callees and parents of the best code hits as candidates (code graph expansion).
BRAIN_GRAPH_EXPAND=true
# How many of the best code hits are expanded through the code graph.
BRAIN_GRAPH_EXPAND_TOP=5
# Ask/enhance only: one short model call turns the prompt into extra search terms (English identifiers, synonyms, translations).
BRAIN_QUERY_EXPANSION=true
# Seconds for the expansion call; on timeout the search continues without it.
BRAIN_QUERY_EXPANSION_TIMEOUT=20

# ---- Search --------------------------------------------------------------------------------
# Code hits returned per search.
BRAIN_SEARCH_TOP_K=8
# Document passages returned per search.
BRAIN_SEARCH_DOC_CHUNKS=6
# Seconds before a search part (code or docs) is abandoned.
BRAIN_SEARCH_TIMEOUT=60
# Size budget of rendered search context given to agents.
BRAIN_CONTEXT_MAX_CHARS=16000
# How much of each code hit search writes for AI agents, MCP and the CLI (less = fewer tokens): brief = location, signature, callers, callees and why it matched; normal = also the source of the 3 best hits; full = the source of every hit. A request can choose another level. One of: brief, normal, full.
BRAIN_SEARCH_DETAIL=normal
# Approximate token limit of one code-tool answer for agents (trace, grep, overview); longer answers are cut and say how to get the rest.
BRAIN_TOOL_MAX_TOKENS=2500

# ---- Ask agent -----------------------------------------------------------------------------
# Chat model for the ask agent (empty = BRAIN_LLM_MODEL).
BRAIN_ASK_MODEL=
# Total seconds for one question (all steps).
BRAIN_ASK_TIMEOUT=180
# Maximum tool-calling rounds before answering.
BRAIN_ASK_MAX_STEPS=6
# Maximum tokens of the answer.
BRAIN_ASK_MAX_TOKENS=1500
# Sampling temperature.
BRAIN_ASK_TEMPERATURE=0.1

# ---- Enhance agent -------------------------------------------------------------------------
# Chat model for the prompt enhancer (empty = BRAIN_LLM_MODEL).
BRAIN_ENHANCE_MODEL=
# Total seconds for one enhancement (all steps).
BRAIN_ENHANCE_TIMEOUT=120
# Maximum tool-calling rounds before writing the prompt.
BRAIN_ENHANCE_MAX_STEPS=4
# Maximum tokens of the enhanced prompt.
BRAIN_ENHANCE_MAX_TOKENS=1800
# Sampling temperature.
BRAIN_ENHANCE_TEMPERATURE=0.2

# ---- Project guide -------------------------------------------------------------------------
# Chat model for the project guide (empty = BRAIN_LLM_MODEL).
BRAIN_GUIDE_MODEL=
# Total seconds for one project guide (all steps).
BRAIN_GUIDE_TIMEOUT=300
# Maximum tool-calling rounds before writing the guide.
BRAIN_GUIDE_MAX_STEPS=5
# Maximum tokens of the guide.
BRAIN_GUIDE_MAX_TOKENS=3000
# Sampling temperature.
BRAIN_GUIDE_TEMPERATURE=0.2

# ---- Code graph ----------------------------------------------------------------------------
# Code graph plug-in: a name in brain/providers or 'package.module:Class'.
BRAIN_CODE_PROVIDER=codebase_memory
# Path to codebase-memory-mcp (empty = bin/<os>/ of this install).
CBM_BIN=
# full = all files + semantic vectors; moderate; fast = no vectors. One of: full, moderate, fast.
CBM_INDEX_MODE=full
# Seconds one repository index may take.
CBM_INDEX_TIMEOUT=7200
# Seconds one code-graph query may take.
CBM_QUERY_TIMEOUT=120
# Semantic code search: local = only the code engine's bundled code embeddings (offline, English-oriented); both = also a code vector index built with the corporate multilingual embedding model (Turkish questions find English code by meaning; costs one embedding pass per changed symbol after each sync). One of: local, both.
BRAIN_CODE_VECTORS=both
# Symbols per embedding request when building the corporate code vectors.
BRAIN_CODE_VECTORS_BATCH=64
# Parallel embedding requests when building the corporate code vectors.
BRAIN_CODE_VECTORS_PARALLEL=4
# Largest number of symbols embedded per repository.
BRAIN_CODE_VECTORS_MAX=200000

# ---- Updates & webhooks --------------------------------------------------------------------
# Clone/update and index all repositories when the server starts.
BRAIN_SYNC_ON_START=true
# Also fetch+index every N minutes (0 = webhooks only).
BRAIN_SYNC_INTERVAL_MINUTES=0
# Local-path repositories: every N seconds, check whether the tracked branch moved (git pull, merge, commit) and re-index it (0 = off).
BRAIN_WATCH_LOCAL_SECONDS=30
# Branch the code graph follows when a repository does not name one.
BRAIN_DEFAULT_BRANCH=main
# Events that trigger an update of the tracked branch: merge (MR/PR merged), push (any push to it).
BRAIN_WEBHOOK_EVENTS=merge,push
# Group-level GitLab webhook secret (/webhooks/gitlab). Each repository also has its own webhook and secret.
BRAIN_GITLAB_WEBHOOK_SECRET=
# Group-level TFS service-hook user (/webhooks/tfs).
BRAIN_TFS_WEBHOOK_USER=
# Group-level TFS service-hook password (/webhooks/tfs). Each repository also has its own webhook and secret.
BRAIN_TFS_WEBHOOK_PASSWORD=

# ---- Git servers ---------------------------------------------------------------------------
# Seconds for one git clone/fetch.
BRAIN_GIT_TIMEOUT=900
# Corporate GitLab base URL, e.g. https://gitlab.corp.local. Repositories can then be written as gitlab:group/project.
BRAIN_GITLAB_URL=
# User for HTTPS clone/fetch from BRAIN_GITLAB_URL (any name works with a token).
BRAIN_GITLAB_USER=
# GitLab personal/project access token with read_repository.
BRAIN_GITLAB_TOKEN=
# Corporate TFS / Azure DevOps Server collection URL, e.g. https://tfs.corp.local/tfs/DefaultCollection. Repositories can then be written as tfs:Project/repo.
BRAIN_TFS_URL=
# User for HTTPS clone/fetch from BRAIN_TFS_URL.
BRAIN_TFS_USER=
# TFS / Azure DevOps personal access token with Code (read).
BRAIN_TFS_TOKEN=
# User for HTTPS git on any other server (fallback credentials).
BRAIN_GIT_USER=
# Token for HTTPS git on any other server (fallback credentials).
BRAIN_GIT_TOKEN=
# Corporate CA certificate (PEM) for the git servers' HTTPS.
BRAIN_GIT_CA_BUNDLE=
# Verify TLS for git (false only for broken internal CAs).
BRAIN_GIT_SSL_VERIFY=true

# ---- Requirements writer -------------------------------------------------------------------
# Chat model for the requirements writer (empty = BRAIN_LLM_MODEL).
BRAIN_SRS_MODEL=
# Total seconds for one specification (all sections).
BRAIN_SRS_TIMEOUT=1800
# Most capabilities (feature areas) described in one specification.
BRAIN_SRS_MAX_CAPABILITIES=12
# Maximum tokens per written section.
BRAIN_SRS_MAX_TOKENS=3000
# Sampling temperature.
BRAIN_SRS_TEMPERATURE=0.2
# Language of the specification: auto (same as the request), English, Turkish ...
BRAIN_SRS_LANGUAGE=auto

# ---- Document graph ------------------------------------------------------------------------
# Document graph plug-in: a name in brain/providers or 'package.module:Class'.
BRAIN_DOC_PROVIDER=lightrag
# Internal LightRAG port (127.0.0.1 only).
LIGHTRAG_PORT=9631
# Chat model for entity extraction (empty = BRAIN_LLM_MODEL).
LIGHTRAG_LLM_MODEL=
# LightRAG LLM_TIMEOUT: seconds for one chat call during entity/relation extraction and summaries.
LIGHTRAG_LLM_TIMEOUT=240
# LightRAG EMBEDDING_TIMEOUT: seconds for one embedding call.
LIGHTRAG_EMBEDDING_TIMEOUT=60
# LightRAG TIMEOUT: seconds the LightRAG server allows for one HTTP request.
LIGHTRAG_TIMEOUT=300
# Seconds to wait for LightRAG to become healthy.
LIGHTRAG_STARTUP_TIMEOUT=180
# Seconds for one request from this server to LightRAG.
LIGHTRAG_REQUEST_TIMEOUT=600
# Concurrent LLM calls during ingestion.
LIGHTRAG_MAX_ASYNC=4
# Documents processed in parallel.
LIGHTRAG_MAX_PARALLEL_INSERT=2
# Language of extracted entity descriptions (English, Turkish ...).
LIGHTRAG_SUMMARY_LANGUAGE=English
# Tokens per chunk.
LIGHTRAG_CHUNK_SIZE=1200
# Token overlap between chunks.
LIGHTRAG_CHUNK_OVERLAP=100
# Retrieval mode: mix (graph+vectors), hybrid, local, global, naive. One of: mix, hybrid, local, global, naive.
LIGHTRAG_QUERY_MODE=mix
# Entities/relations retrieved per query.
LIGHTRAG_TOP_K=20
# Override LightRAG's parser routing (empty = automatic).
LIGHTRAG_PARSER=
